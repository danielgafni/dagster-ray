"""
The container a Python module runs in, built from its committed files.
The runtime module, the generated static entrypoint and the shared entrypoint
under entrypoint/ all share this build; the two entrypoints carry a copy with
the block below inlined, because neither can read a file of its own.
"""
type PythonModuleBuild {
  """
  Context the module lives in, mounted whole so relative paths resolve.
  """
  pub contextDir: Directory!

  """
  Module directory, relative to the context.
  """
  pub subPath: String!

  pub moduleName: String!

  new(contextDir: Directory! = directory, subPath: String! = ".", moduleName: String! = "") {
    self.contextDir = contextDir
    self.subPath = subPath
    self.moduleName = moduleName
    self
  }

  let modSourceDirPath: String! = "/src"
  let venvPath: String! = "/opt/venv"
  let genDir: String! = "sdk"
  let clientsDir: String! = "clients"
  let sdkGenPath: String! = "src/dagger/client/gen.py"
  let projectCfg: String! = "pyproject.toml"
  let pipCompileLock: String! = "requirements.lock"
  let uvLock: String! = "uv.lock"
  let uvCacheVolume: String! = "modpython-uv"
  let pipCacheVolume: String! = "modpython-pip"

  let defaultBaseImage: String! = "python:3.14-slim@sha256:486b8092bfb12997e10d4920897213a06563449c951c5506c2a2cfaf591c599f"
  let defaultUvImage: String! = "ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a"

  """
  The module directory.
  """
  pub source: Directory! {
    subdir(contextDir, subPath)
  }

  """
  The installed module, without an entrypoint. Not named `container`: a field
  of that name would shadow the global `container` that `base` starts from.
  """
  pub installed: Container! {
    if (source.exists(projectCfg) == false) {
      raise "module \"" + moduleName + "\" has no " + projectCfg + "; run `dagger generate` and commit the generated files"
    } else if (hasPythonFiles(source) == false) {
      raise "no python files found in module source"
    } else {
      let cfg = pyConfig(contextDir, subPath)
      checkGeneratedFiles(source, moduleName, requiredGeneratedFiles(source, cfg))

      let baseImage = baseImageFor(source, cfg)
      let uvImage = uvImageFor(cfg)
      # Unique per module source: the uv cache keys some entries on source paths.
      let contextDirPath = modSourceDirPath + "/" + source.digest
      let packageName = packageNameFor(moduleName, cfg)

      let compiled = base(baseImage, uvImage, cfg)
        .withEnvVariable("UV_COMPILE_BYTECODE", "1")
        # Bytecode keyed on its source's hash rather than the time uv copied
        # the source, so the same inputs build the same layer, byte for byte.
        .withEnvVariable("PYC_INVALIDATION_MODE", "CHECKED_HASH")
      let built = dependencies(compiled, source, cfg)
        .withWorkdir(join(contextDirPath, subPath))
        .withMountedDirectory(contextDirPath, withoutVenv)
        # Last, so the layers above are shared between modules.
        .withEnvVariable("DAGGER_MODULE", moduleName)
        .withEnvVariable("DAGGER_DEFAULT_PYTHON_PACKAGE", packageName)
        .withEnvVariable("DAGGER_MAIN_OBJECT", mainObjectName(moduleName))

      install(built, source, cfg)
    }
  }

  """
  The workspace members of a scope's pyproject.toml, read as the build does.
  """
  pub scopeMembers(pyproject: File!): [String!]! {
    pyConfig(directory.withFile(projectCfg, pyproject), ".").members
  }

  """
  The class name of a module's main object, converted like the engine's builtin
  Python runtime (strcase.ToCamel) so a module loads the same on both.
  """
  pub mainObjectName(name: String!): String! {
    name
      .trimSpace
      .split("")
      .reduce(CamelState(out: "", capNext: true, prevIsCap: false)) { state, c =>
        let isCap = c.containsMatch("^[A-Z]$")
        let isLow = c.containsMatch("^[a-z]$")
        let isNum = c.containsMatch("^[0-9]$")
        if (isCap or isLow) {
          let v = if (state.capNext and isLow) {
            c.toUpper
          } else if (state.capNext == false and state.prevIsCap and isCap) {
            c.toLower
          } else {
            c
          }
          CamelState(out: state.out + v, capNext: false, prevIsCap: isCap)
        } else if (isNum) {
          CamelState(out: state.out + c, capNext: true, prevIsCap: false)
        } else {
          CamelState(
            out: state.out,
            capNext: c == "_" or c == " " or c == "-" or c == ".",
            prevIsCap: false,
          )
        }
      }
      .out
  }

  let base(baseImage: String!, uvImage: String!, cfg: PyConfig!): Container! {
    let uvBins = container.from(uvImage).rootfs

    let ctr = container
      .from(baseImage)
      # Informational only, in case a module finds them useful.
      .withEnvVariable("DAGGER_BASE_IMAGE", baseImage)
      .withEnvVariable("PYTHONUNBUFFERED", "1")
      .withEnvVariable("PIP_DISABLE_PIP_VERSION_CHECK", "1")
      .withEnvVariable("PIP_ROOT_USER_ACTION", "ignore")
      .withMountedFile("/usr/local/bin/uv", uvBins.file("uv"))
      .withMountedFile("/usr/local/bin/uvx", uvBins.file("uvx"))
      .withMountedCache("/root/.cache/uv", cacheVolume(uvCacheVolume))
      .withEnvVariable("DAGGER_UV_IMAGE", uvImage)
      .withEnvVariable("DAGGER_UV_VERSION", imageTag(uvImage))
      .withEnvVariable("UV_SYSTEM_PYTHON", "1")
      .withEnvVariable("UV_LINK_MODE", "copy")
      .withEnvVariable("UV_NATIVE_TLS", "1")
      .withEnvVariable("UV_PROJECT_ENVIRONMENT", venvPath)

    let withPip = if (cfg.useUv) {
      ctr
    } else {
      ctr.withMountedCache("/root/.cache/pip", cacheVolume(pipCacheVolume))
    }
    let withIndex = if (cfg.indexURL == "") {
      withPip
    } else {
      withPip.withEnvVariable("UV_INDEX_URL", cfg.indexURL)
    }
    if (cfg.extraIndexURL == "") {
      withIndex
    } else {
      withIndex.withEnvVariable("UV_EXTRA_INDEX_URL", cfg.extraIndexURL)
    }
  }

  """
  The module's dependencies, installed from dependencyInputs alone so that a
  source edit leaves this layer cached. The SDK files and the generated
  clients are installed non-editable so uv compiles their bytecode once, not
  on every call into a throwaway mount.
  """
  let dependencies(ctr: Container!, source: Directory!, cfg: PyConfig!): Container! {
    if (cfg.useUv == false) {
      # pip installs a project's dependencies only with the project itself.
      ctr
    } else {
      let inputs = dependencyInputs(cfg)
      # Unique per input, for the same reason as the source's own path.
      let inputsPath = modSourceDirPath + "/" + inputs.digest
      let mounted = ctr
        .withWorkdir(join(inputsPath, subPath))
        .withMountedDirectory(inputsPath, inputs)

      if (source.exists(uvLock)) {
        # --locked: fail loudly on a stale lockfile instead of re-resolving.
        # In a scope, sync installs the members the project depends on, which
        # --no-install-project leaves in.
        mounted
          .withExec(["uv", "sync", "--no-dev", "--locked", "--no-editable", "--no-install-project"])
          .withoutMount(inputsPath)
          .withEnvVariable("VIRTUAL_ENV", "$UV_PROJECT_ENVIRONMENT", expand: true)
          .withEnvVariable("PATH", "$VIRTUAL_ENV/bin:$PATH", expand: true)
      } else {
        let deps = if (source.exists(pipCompileLock)) {
          # The lockfile is complete, so skip resolving.
          ["--no-deps", "-r", pipCompileLock]
        } else {
          ["-r", projectCfg]
        }
        mounted
          .withExec(["uv", "pip", "install", "--no-editable"] + localPackages(cfg) + deps)
          .withoutMount(inputsPath)
      }
    }
  }

  """
  The module's own package, editable, on top of its dependencies.
  """
  let install(ctr: Container!, source: Directory!, cfg: PyConfig!): Container! {
    if (cfg.useUv and source.exists(uvLock)) {
      # uv pip ignores VIRTUAL_ENV while UV_SYSTEM_PYTHON is set.
      ctr.withExec(["uv", "pip", "install", "--python", venvPath + "/bin/python", "--no-deps", "-e", "."])
    } else if (cfg.useUv) {
      ctr.withExec(["uv", "pip", "install", "--no-deps", "-e", "."])
    } else {
      # pip reads no uv sources, so every local package goes in by path, in
      # the same command that resolves the project's dependencies on them.
      ctr.withExec(["pip", "install"] + localPackages(cfg) + ["-e", "."])
    }
  }

  """
  The files the dependency install reads, as workspaceRead names them; the
  whole context where the install may read any file.
  """
  let dependencyInputs(cfg: PyConfig!): Directory! {
    if (cfg.inputs.filter { path => path == "." }.length > 0) {
      withoutVenv
    } else {
      filesOf(
        contextDir,
        include: cfg.inputs,
        # In the SDK's member but no part of its package, and `dagger
        # generate` rewrites it whenever a function's signature changes.
        exclude: [join(subPath, genDir + "/entrypoint").trimPrefix("./")],
      )
    }
  }

  """
  The files of a directory that the patterns select, copied one by one: a
  file read from a directory keeps the digest of its content, where a
  directory derived from an entrypoint's module source has none, so what
  reads them is cached on these files alone and not on every file of the
  source.
  """
  let filesOf(dir: Directory!, include: [String!]!, exclude: [String!]!): Directory! {
    let files = dir
      .filter(include: include, exclude: exclude)
      .glob("**")
      .filter { path => path.hasSuffix("/") == false }
    let parents = files.map { path => parentDir(path) }.reduce([] :: [String!]!) { seen, parent =>
      if (seen.filter { other => other == parent }.length > 0) { seen } else { seen + [parent] }
    }
    parents.reduce(directory) { tree, parent =>
      tree.withFiles(parent, files.filter { path => parentDir(path) == parent }.map { path => dir.file(path) })
    }
  }

  """
  What the module installs from its own tree: the members of a scope's
  workspace that the project depends on, directly or through another member,
  the way `uv sync` picks them; or the vendored library of the layout before.
  A member nothing depends on is not installed: it may not even install here.
  """
  let localPackages(cfg: PyConfig!): [String!]! {
    if (cfg.isScope) {
      cfg.locals
    } else {
      ["./" + genDir]
    }
  }

  """
  The workspace as TOML defines it, read by tomllib in the pinned default
  image from the module at `sub` in `dir`: `member\t<path>` for each member,
  then `local\t./<dir>` for each member directory to install, then
  `input\t<path>` for each file and directory of `dir` that the dependency
  install reads, or `input\t.` where it may read any file. The members are
  globs over directories, and each member's dependencies are in its own
  file, so one pass reads them all. Only the files that can name a member,
  a path or a setting go in, so the read is cached until one of them
  changes. A file that does not read is named.
  """
  let workspaceRead(dir: Directory!, sub: String!): [String!]! {
    let lines = container
      .from(defaultBaseImage)
      .withMountedDirectory("/scope", filesOf(
        dir,
        include: ["**/" + projectCfg, "**/uv.toml", "**/.python-version", "**/" + pipCompileLock],
        # No member lives in these, and a virtualenv alone holds hundreds of
        # pyproject.toml files that would reach the read and its cache key.
        exclude: ["**/.venv", "**/__pycache__", "**/node_modules", "**/.git"],
      ))
      .withExec(["python", "-c", workspaceReader, "/scope", sub, genDir])
      .stdout
      .split("\n")
      .filter { line => line != "" }
    let errors = lines.filter { line => line.hasPrefix("error\t") }
    if (errors.length > 0) {
      raise errors.map { line => line.trimPrefix("error\t") }.join("; ")
    } else {
      lines
    }
  }

  let workspaceReader: String! =
    "import glob, os, re, sys, tomllib\n" +
    "root = sys.argv[1]\n" +
    "sub = os.path.normpath(sys.argv[2])\n" +
    "vendored = sys.argv[3]\n" +
    "module = os.path.join(root, sub)\n" +
    "def fail(message):\n" +
    "    print('error\\t' + message)\n" +
    "    sys.exit(0)\n" +
    "def load(rel, file='pyproject.toml'):\n" +
    "    path = os.path.normpath(os.path.join(rel, file))\n" +
    "    try:\n" +
    "        with open(os.path.join(module, path), 'rb') as f:\n" +
    "            return tomllib.load(f)\n" +
    "    except (tomllib.TOMLDecodeError, UnicodeDecodeError, OSError) as e:\n" +
    "        fail(f'{path} is not valid TOML: {e}')\n" +
    "def table(doc, *keys):\n" +
    "    for key in keys:\n" +
    "        doc = doc.get(key) if isinstance(doc, dict) else None\n" +
    "    return doc if isinstance(doc, dict) else {}\n" +
    "def strings(value, key, where):\n" +
    "    if value is None:\n" +
    "        return []\n" +
    "    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):\n" +
    "        fail(f'{where}: {key} is not an array of strings; write it as one, such as {key} = [\"a\", \"b\"]')\n" +
    "    return value\n" +
    "def outside(path):\n" +
    "    joined = os.path.normpath(os.path.join(sub, path))\n" +
    "    return joined == '..' or joined.startswith('../')\n" +
    "def names_parent(value):\n" +
    "    if isinstance(value, str):\n" +
    "        return value == '..' or value.startswith('../') or '/../' in value\n" +
    "    if isinstance(value, dict):\n" +
    "        return any(names_parent(key) or names_parent(item) for key, item in value.items())\n" +
    "    return isinstance(value, list) and any(names_parent(item) for item in value)\n" +
    "def reads_beside(rel, project):\n" +
    "    uv = {key: value for key, value in table(project, 'tool', 'uv').items() if key != 'sources'}\n" +
    "    tool = dict(table(project, 'tool'), uv=uv)\n" +
    "    return names_parent(dict(project, tool=tool)) or os.path.exists(os.path.join(module, rel, 'uv.toml'))\n" +
    "def name(requirement):\n" +
    "    m = re.match(r'\\s*([A-Za-z0-9][A-Za-z0-9._-]*)', requirement if isinstance(requirement, str) else '')\n" +
    "    return re.sub(r'[-_.]+', '-', m.group(1).lower()) if m else ''\n" +
    "doc = load('.')\n" +
    "members = strings(table(doc, 'tool', 'uv', 'workspace').get('members'), 'members', 'pyproject.toml')\n" +
    "wanted = {name(r) for r in strings(table(doc, 'project').get('dependencies'), 'dependencies', 'pyproject.toml')}\n" +
    "dirs = []\n" +
    "for member in members:\n" +
    "    print('member\\t' + member)\n" +
    "    for found in sorted(glob.glob(os.path.join(module, member, 'pyproject.toml'))):\n" +
    "        rel = os.path.relpath(os.path.dirname(found), module)\n" +
    "        if rel not in dirs:\n" +
    "            dirs.append(rel)\n" +
    "docs = {'.': doc}\n" +
    "projects = {}\n" +
    "for rel in dirs:\n" +
    "    docs[rel] = load(rel)\n" +
    "    project = table(docs[rel], 'project')\n" +
    "    projects[rel] = (name(project.get('name')), {name(r) for r in strings(project.get('dependencies'), 'dependencies', rel + '/pyproject.toml')})\n" +
    "needed = []\n" +
    "while True:\n" +
    "    found = [rel for rel in dirs if rel not in needed and projects[rel][0] in wanted]\n" +
    "    if not found:\n" +
    "        break\n" +
    "    needed += found\n" +
    "    wanted = set().union(*(projects[rel][1] for rel in found))\n" +
    "for rel in dirs:\n" +
    "    if rel in needed:\n" +
    "        print('local\\t./' + rel)\n" +
    "inputs = ['pyproject.toml', 'uv.lock', 'uv.toml', '.python-version'] + dirs + ([] if vendored in members else [vendored])\n" +
    "paths = []\n" +
    "sourced = {}\n" +
    "pending = list(docs.items())\n" +
    "while pending:\n" +
    "    rel, member = pending.pop(0)\n" +
    "    for value in table(member, 'tool', 'uv', 'sources').values():\n" +
    "        for source in value if isinstance(value, list) else [value]:\n" +
    "            path = source.get('path') if isinstance(source, dict) else None\n" +
    "            if not isinstance(path, str):\n" +
    "                continue\n" +
    "            path = os.path.normpath(os.path.join(rel, path))\n" +
    "            if path in paths:\n" +
    "                continue\n" +
    "            paths.append(path)\n" +
    "            if path not in dirs and not os.path.isabs(path) and not outside(path) and os.path.exists(os.path.join(module, path, 'pyproject.toml')):\n" +
    "                sourced[path] = load(path)\n" +
    "                pending.append((path, sourced[path]))\n" +
    "inputs += [path for path in paths if path not in dirs + [vendored]]\n" +
    "settings = [table(member, 'tool', 'uv') for member in list(docs.values()) + list(sourced.values())]\n" +
    "if os.path.exists(os.path.join(module, 'uv.toml')):\n" +
    "    settings.append(load('.', 'uv.toml'))\n" +
    "urls = []\n" +
    "for uv in settings + [table(uv, 'pip') for uv in settings]:\n" +
    "    indexes = uv.get('index') if isinstance(uv.get('index'), list) else [uv.get('index')]\n" +
    "    urls += [uv.get('index-url')] + [table(index).get('url') for index in indexes]\n" +
    "    for key in ('extra-index-url', 'find-links'):\n" +
    "        urls += uv.get(key) if isinstance(uv.get(key), list) else []\n" +
    "whole = any(isinstance(url, str) and '://' not in url for url in urls)\n" +
    "whole = whole or any('project' not in member or bool(set(table(member, 'project').get('dynamic') or []) - {'version'}) for member in list(docs.values()) + list(sourced.values()))\n" +
    "whole = whole or os.path.exists(os.path.join(module, 'requirements.lock'))\n" +
    "whole = whole or any(os.path.isabs(path) or outside(path) for path in inputs)\n" +
    "# The module itself installs after the source mount, so members, path sources and the\n" +
    "# SDK-written vendored package are what the dependency step builds.\n" +
    "whole = whole or any('backend-path' in table(member, 'build-system') for member in [docs[rel] for rel in dirs] + list(sourced.values()))\n" +
    "# A path source the walk follows reads only its own directory unless its project names\n" +
    "# a parent directory outside its [tool.uv.sources] or keeps a uv.toml beside it.\n" +
    "whole = whole or any(reads_beside(rel, project) for rel, project in sourced.items())\n" +
    "above = []\n" +
    "parts = [] if sub == '.' else sub.split('/')\n" +
    "for i in range(len(parts)):\n" +
    "    rel = os.path.join(*parts[:i]) if i else '.'\n" +
    "    whole = whole or any(os.path.exists(os.path.join(root, rel, f)) for f in ('pyproject.toml', 'uv.toml'))\n" +
    "    if os.path.exists(os.path.join(root, rel, '.python-version')):\n" +
    "        above.append(os.path.normpath(os.path.join(rel, '.python-version')))\n" +
    "for path in ['.'] if whole else above + [os.path.normpath(os.path.join(sub, p)) for p in inputs]:\n" +
    "    print('input\\t' + path)\n" +
    "def text(value):\n" +
    "    return value if isinstance(value, str) and '\\t' not in value and '\\n' not in value else ''\n" +
    "def flag(value, default):\n" +
    "    return value if isinstance(value, bool) else default\n" +
    "project = table(doc, 'project')\n" +
    "dagger = table(doc, 'tool', 'dagger')\n" +
    "indexes = table(doc, 'tool', 'uv').get('index')\n" +
    "indexes = [index for index in (indexes if isinstance(indexes, list) else [indexes]) if isinstance(index, dict) and text(index.get('name')) == '']\n" +
    "settings = {\n" +
    "    'projectName': text(project.get('name')),\n" +
    "    'requiresPython': text(project.get('requires-python')),\n" +
    "    'baseImage': text(dagger.get('base-image')),\n" +
    "    'useUv': 'true' if flag(dagger.get('use-uv'), True) else 'false',\n" +
    "    'uvVersion': text(dagger.get('uv-version')),\n" +
    "    'vendorPath': text(table(doc, 'tool', 'uv', 'sources', 'dagger-io').get('path')),\n" +
    "    'indexURL': next((text(index.get('url')) for index in indexes if flag(index.get('default'), False)), ''),\n" +
    "    'extraIndexURL': next((text(index.get('url')) for index in indexes if not flag(index.get('default'), False)), ''),\n" +
    "}\n" +
    "for key, value in settings.items():\n" +
    "    print('setting\\t' + key + '\\t' + value)\n"

  """
  The generated files a module needs before it builds. A scope needs each of
  the SDK's members it lists; a user's member is the user's to provide.
  """
  let requiredGeneratedFiles(source: Directory!, cfg: PyConfig!): [String!]! {
    if (cfg.isScope) {
      cfg.members
        .filter { member =>
          (member == genDir or member.hasPrefix(clientsDir + "/")) and member.contains("*") == false
        }
        .map { member => member + "/" + projectCfg }
    } else {
      # A published dagger-io brings its own files, and the SDK files no longer
      # read bindings from src/dagger_gen.py, so nothing generated is required.
      let vendorPath = vendorPathFor(source, cfg)
      if (vendorPath == "") {
        [] :: [String!]!
      } else {
        [vendorPath + "/" + projectCfg, vendorPath + "/" + sdkGenPath]
      }
    }
  }

  """
  Fail early when the committed generated files are missing.
  """
  let checkGeneratedFiles(source: Directory!, modName: String!, required: [String!]!): Void {
    required.each { rel =>
      if (source.exists(rel, expectedType: ExistsType.REGULAR_TYPE) == false) {
        raise "module \"" + modName + "\": generated file \"" + rel + "\" is missing; run `dagger generate` and commit the generated files"
      }
      null
    }
    null
  }

  """
  Empty when a uv.lock module depends on a published dagger-io instead.
  """
  let vendorPathFor(source: Directory!, cfg: PyConfig!): String! {
    if (cfg.useUv and source.exists(uvLock)) { cfg.vendorPath } else { genDir }
  }

  let packageNameFor(modName: String!, cfg: PyConfig!): String! {
    let project = if (cfg.projectName == "") {
      modName.toLower.replaceMatches("[^a-z0-9]+", "-").trim("-")
    } else {
      cfg.projectName
    }
    project.replace("-", "_")
  }

  """
  Prefers the digest-pinned default image when it matches the requested version.
  """
  let baseImageFor(source: Directory!, cfg: PyConfig!): String! {
    if (cfg.baseImage != "") {
      cfg.baseImage
    } else {
      let version = pythonVersionFor(source, cfg)
      let wanted = "python:" + version + "-slim"
      if (version == "" or defaultBaseImage.hasPrefix(wanted)) {
        defaultBaseImage
      } else {
        wanted
      }
    }
  }

  let pythonVersionFor(source: Directory!, cfg: PyConfig!): String! {
    if (source.exists(".python-version")) {
      source.file(".python-version").contents.trimSpace
    } else {
      # requires-python is a floor, but with `>=` or `==` it names a supported version.
      let minimum = cfg.requiresPython.trimSpace
      if (minimum.hasPrefix("==") or minimum.hasPrefix(">=")) {
        minimum.trimPrefix("==").trimPrefix(">=").trimSpace
      } else {
        ""
      }
    }
  }

  let uvImageFor(cfg: PyConfig!): String! {
    if (cfg.uvVersion == "" or cfg.uvVersion == imageTag(defaultUvImage)) {
      defaultUvImage
    } else {
      # Uv's image tag matches the version exactly.
      "ghcr.io/astral-sh/uv:" + cfg.uvVersion
    }
  }

  let hasPythonFiles(source: Directory!): Boolean! {
    source.glob("src/**/*.py").length > 0 or source.glob("*.py").length > 0
  }

  """
  A virtualenv left in the module by the host must not reach the build.
  """
  let withoutVenv: Directory! {
    if (source.exists(".venv")) {
      contextDir.withoutDirectory(join(subPath, ".venv"))
    } else {
      contextDir
    }
  }

  let subdir(dir: Directory!, path: String!): Directory! {
    if (path == "" or path == ".") { dir } else { dir.directory(path) }
  }

  let join(base: String!, rel: String!): String! {
    if (rel == "" or rel == ".") { base } else { base + "/" + rel }
  }

  let parentDir(path: String!): String! {
    let parts = path.split("/")
    if (parts.length == 1) { "." } else { parts.takeFirst(parts.length - 1).join("/") }
  }

  let imageTag(ref: String!): String! {
    let named = ref.split("@").takeFirst(1).join("")
    let parts = named.split(":")
    if (parts.length < 2) { "" } else { parts.takeLast(1).join("") }
  }

  """
  Read with a TOML parser in workspaceRead, because the file is the user's
  content: quoting, dotted keys and multi-line strings are theirs. A key of
  another type than the one the templates and `mod config set` write reads
  as unset.
  """
  let pyConfig(dir: Directory!, sub: String!): PyConfig! {
    let workspace = workspaceRead(dir, sub)
    PyConfig(
      projectName: setting(workspace, "projectName"),
      requiresPython: setting(workspace, "requiresPython"),
      baseImage: setting(workspace, "baseImage"),
      useUv: setting(workspace, "useUv") == "true",
      uvVersion: setting(workspace, "uvVersion"),
      vendorPath: setting(workspace, "vendorPath"),
      members: readLines(workspace, "member"),
      locals: readLines(workspace, "local"),
      inputs: readLines(workspace, "input"),
      indexURL: setting(workspace, "indexURL"),
      extraIndexURL: setting(workspace, "extraIndexURL"),
    )
  }

  let readLines(workspace: [String!]!, kind: String!): [String!]! {
    workspace
      .filter { line => line.hasPrefix(kind + "\t") }
      .map { line => line.trimPrefix(kind + "\t") }
  }

  let setting(workspace: [String!]!, key: String!): String! {
    readLines(workspace, "setting\t" + key).join("")
  }
}

"""
What this runtime reads from a module's pyproject.toml.
"""
type PyConfig {
  pub projectName: String!
  pub requiresPython: String!
  pub baseImage: String!
  pub useUv: Boolean!
  pub uvVersion: String!
  pub vendorPath: String!

  """
  The `[tool.uv.workspace] members` of a scope; empty in the layout before.
  """
  pub members: [String!]!

  """
  The member directories the project depends on, as localPackages names them.
  """
  pub locals: [String!]!

  """
  The paths in the context that the dependency install reads, or "." where
  it may read any file (dependencyInputs).
  """
  pub inputs: [String!]!
  pub indexURL: String!
  pub extraIndexURL: String!

  new(
    projectName: String! = "",
    requiresPython: String! = "",
    baseImage: String! = "",
    useUv: Boolean! = true,
    uvVersion: String! = "",
    vendorPath: String! = "",
    members: [String!]! = [],
    locals: [String!]! = [],
    inputs: [String!]! = [],
    indexURL: String! = "",
    extraIndexURL: String! = "",
  ) {
    self.projectName = projectName
    self.requiresPython = requiresPython
    self.baseImage = baseImage
    self.useUv = useUv
    self.uvVersion = uvVersion
    self.vendorPath = vendorPath
    self.members = members
    self.locals = locals
    self.inputs = inputs
    self.indexURL = indexURL
    self.extraIndexURL = extraIndexURL
    self
  }

  """
  Whether the module is a scope of the unified layout, whose SDK files are
  the workspace member sdk/ rather than a library vendored by path.
  """
  pub isScope: Boolean! {
    members.filter { member => member == "sdk" }.length > 0
  }
}

"""
Accumulator for the CamelCase conversion of a module name.
"""
type CamelState {
  pub out: String!
  pub capNext: Boolean!
  pub prevIsCap: Boolean!

  new(out: String! = "", capNext: Boolean! = true, prevIsCap: Boolean! = false) {
    self.out = out
    self.capNext = capNext
    self.prevIsCap = prevIsCap
    self
  }
}
